# STN-Delta Environment Variables
# Copy to .env.local and fill in your values

# ─── TON Network ─────────────────────────────────────────────────────────────
# Get free API keys from @tonapibot on Telegram
VITE_TON_TESTNET_API_KEY=
VITE_TON_MAINNET_API_KEY=

# ─── EVM / Base Network ──────────────────────────────────────────────────────
# Optional: override default public RPC with a private one (Alchemy/Infura recommended)
VITE_BASE_SEPOLIA_RPC=https://sepolia.base.org
VITE_BASE_MAINNET_RPC=https://mainnet.base.org

# ─── WalletConnect ───────────────────────────────────────────────────────────
# Get a free project ID at https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=

# ─── STON.fi / Omniston ──────────────────────────────────────────────────────
# Optional: custom Omniston API key (contact STON.fi for production access)
VITE_OMNISTON_API_KEY=

# ─── App ─────────────────────────────────────────────────────────────────────
# Set this to your production domain for the TON Connect manifest
VITE_APP_URL=http://localhost:5174
